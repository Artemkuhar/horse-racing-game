{
  "name": "horse-racing-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "test:unit": "vue-cli-service test:unit",
    "test:unit:coverage": "vue-cli-service test:unit --coverage --coverageReporters=text --coverageReporters=text-summary",
    "test:e2e": "cypress run",
    "test:e2e:ci": "start-server-and-test \"yarn serve --port 4173\" http://localhost:4173 \"cypress run\"",
    "lint": "eslint --ext .ts,.js,.vue src cypress",
    "lint:fix": "eslint --ext .ts,.js,.vue src cypress --fix",
    "lint:ci": "eslint --ext .ts,.js,.vue src cypress --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "core-js": "^3.8.3",
    "vue": "^2.6.14",
    "vue-router": "^3.5.1",
    "vuetify": "^2.7.0",
    "vuetify-loader": "^1.9.0",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@types/jest": "27.5.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-plugin-typescript": "~5.0.0",
    "@vue/cli-plugin-unit-jest": "~5.0.0",
    "@vue/cli-plugin-vuex": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/test-utils": "^1.3.6",
    "@vue/vue2-jest": "^29.2.6",
    "cypress": "^13.11.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.6",
    "start-server-and-test": "^2.0.5",
    "ts-jest": "^29.4.6",
    "typescript": "^4.9.5",
    "vue-eslint-parser": "^10.2.0",
    "vue-template-compiler": "^2.6.14"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix"
    ],
    "*.vue": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,md,json,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
